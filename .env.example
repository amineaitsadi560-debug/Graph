# Copy to .env.local for local development. On Netlify, set the same two variables in
# Site configuration → Environment variables.
# Both values are PUBLIC by design (they ship in the browser bundle). Row Level Security protects the data.
# NEVER put the Supabase "service_role" key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
